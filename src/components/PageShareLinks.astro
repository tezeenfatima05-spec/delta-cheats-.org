---
import { canonicalUrl } from '../config/seo';

interface Props {
  pageTitle: string;
  pathname?: string;
  class?: string;
}

const { pageTitle, pathname = Astro.url.pathname, class: className } = Astro.props;
const shareUrl = encodeURIComponent(canonicalUrl(pathname));
const shareText = encodeURIComponent(pageTitle);
---

<nav
  class:list={['page-share flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted-foreground', className]}
  aria-label="Share this page"
>
  <span class="font-medium text-foreground">Share</span>
  <a
    href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareText}`}
    rel="noopener noreferrer"
    target="_blank"
  >
    X
  </a>
  <a
    href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`}
    rel="noopener noreferrer"
    target="_blank"
  >
    Facebook
  </a>
</nav>
